{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window on macOS",
  "windows": [
    "main",
    "dashboard"
  ],
  "platforms": [
    "macOS"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "x-apple.systempreferences:*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart",
    "clipboard-manager:allow-write-text",
    "macos-permissions:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "shell:allow-open",
    "core:window:allow-start-dragging",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://0.0.0.0:*" },
        { "url": "https://localhost:*" },
        { "url": "https://127.0.0.1:*" },
        { "url": "http://localhost:*/**" },
        { "url": "http://127.0.0.1:*/**" },
        { "url": "http://0.0.0.0:*/**" },
        { "url": "https://localhost:*/**" },
        { "url": "https://127.0.0.1:*/**" },
        { "url": "http://*:*" },
        { "url": "http://*:*/**" },
        { "url": "https://*:*" },
        { "url": "https://*:*/**" }
      ]
    }
  ]
}
